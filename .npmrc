# node-linker=hoisted вместо pnpm-дефолта (символические ссылки на
# content-addressable store): `next build` с output: "standalone"
# копирует node_modules как есть в .next/standalone, а символические
# ссылки там указывают на node_modules/.pnpm/..., который в Dockerfile
# не попадает в финальный слой (COPY --from=builder берёт только
# .next/standalone) — ссылки оказываются битыми (подтверждено локально:
# MODULE_NOT_FOUND на @swc/helpers). Плоский node_modules с реальными
# файлами решает это; известная проблема именно этой связки
# pnpm + Next.js standalone + Docker.
node-linker=hoisted
# node-linker=hoisted сам по себе поднимает в корень node_modules только
# прямые зависимости — @swc/helpers нужен next'у транзитивно и без
# shamefully-hoist остаётся вложенным (подтверждено: с одним только
# node-linker=hoisted файл всё равно не находился). С этой опцией все
# транзитивные зависимости реально лежат в корне node_modules.
shamefully-hoist=true
