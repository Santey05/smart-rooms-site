# Реальные значения для production-сборки — закоммичены намеренно.
#
# Почему: на Amvera переменные окружения из веб-интерфейса недоступны на
# этапе сборки Docker-образа (см. Dockerfile), а Next.js встраивает
# NEXT_PUBLIC_*-переменные в клиентский бандл именно во время `next build`.
# Next.js сам подхватывает .env.production при продакшен-сборке — без
# этого файла бронирование, карта и Sentry в проде работали бы с пустыми
# значениями.
#
# Почему можно коммитить: ни одно из значений ниже не секрет — см.
# пояснения в .env.example у каждой переменной (UID Bnovo не секрет,
# DSN Sentry по дизайну публичный — это обычный client-side идентификатор,
# ключ Яндекс.Карт ограничен доменом в кабинете Яндекса). Настоящий секрет
# проекта — SENTRY_AUTH_TOKEN — сюда не попадает, он нужен только
# опционально для аплоада sourcemaps и остаётся вне репозитория.

NEXT_PUBLIC_BNOVO_UID=f88eee98-47df-4971-8f99-6af292dd65e9
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=363f4af4-3117-4552-a757-9da152cd2d0b
NEXT_PUBLIC_SENTRY_DSN=https://dda43cbff14d29246bf870157996fd20@o4512180118093824.ingest.de.sentry.io/4512180120256592

# ВАЖНО: заполнить после первого деплоя на Amvera — реальным доменом вида
# https://smart-rooms.<ваш-логин>.amvera.io (или своим доменом, если
# подключите). Пока пусто — sitemap.xml, robots.txt, canonical и Open
# Graph будут ссылаться на localhost (см. src/lib/site-url.ts). Один раз
# вписать и закоммитить — дальше трогать не нужно.
NEXT_PUBLIC_SITE_URL=
