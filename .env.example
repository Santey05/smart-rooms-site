# UID объекта размещения в Bnovo, используется модулем бронирования
# (см. CLAUDE.md, раздел 6.1). Не секрет, но конфигурируем через env —
# на случай смены объекта или отдельного тестового окружения.
NEXT_PUBLIC_BNOVO_UID=f88eee98-47df-4971-8f99-6af292dd65e9

# API-ключ Яндекс Карт (JavaScript API), используется картой в блоке
# «Петербург рядом». Бесплатный, получить на developer.tech.yandex.ru:
# «Подключить API» → «JavaScript API и HTTP Геокодер» → указать домен сайта.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# DSN проекта Sentry (мониторинг ошибок фронтенда, CLAUDE.md раздел 13).
# Получить бесплатно на sentry.io (план Developer: 5000 ошибок/мес, без
# карты) — создать проект с платформой Next.js, скопировать DSN со
# страницы настроек проекта (Settings → Client Keys (DSN)). Пусто —
# Sentry просто не инициализируется, сайт работает как обычно.
NEXT_PUBLIC_SENTRY_DSN=

# Нужны только для аплоада сорсмапов в проде (необязательно) — слаг
# организации и проекта в Sentry и персональный auth-токен
# (Settings → Auth Tokens). Без них сборка просто пропускает этот шаг.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
