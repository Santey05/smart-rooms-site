# UID объекта размещения в Bnovo, используется модулем бронирования
# (см. CLAUDE.md, раздел 6.1). Не секрет, но конфигурируем через env —
# на случай смены объекта или отдельного тестового окружения.
NEXT_PUBLIC_BNOVO_UID=f88eee98-47df-4971-8f99-6af292dd65e9

# API-ключ Яндекс Карт (JavaScript API), используется картой в блоке
# «Об отеле». Бесплатный, получить на developer.tech.yandex.ru:
# «Подключить API» → «JavaScript API и HTTP Геокодер» → указать домен сайта.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
